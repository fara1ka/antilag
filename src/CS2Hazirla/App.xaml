<Application x:Class="CS2Hazirla.App"
             xmlns:local="clr-namespace:CS2Hazirla"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:MotionDictionary/>
                <ResourceDictionary Source="Theme/Tokens.xaml"/>
                <ResourceDictionary Source="Theme/Icons.xaml"/>
                <ResourceDictionary Source="Theme/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <local:NotBoolToVisibilityConverter x:Key="NotB2V"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
