<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- =====================================================================================
         Antilag: derin lacivert yüzeyler, tek lavanta-çivit vurgu ailesi. Derinlik üç şeyden gelir: yüzey basamakları (üstteki katman bir tık açık),
         1 px'lik degrade kenar çizgisi ("cam kenarı") ve ışık (ışıma = yarı saydam radyal degrade; Effect/Blur yok, dosya yok).
         Durum renkleri (yeşil, sarı, kırmızı) yalnızca durum içindir ve her zaman bir sözcükle birlikte gösterilir.
         Aralık: 4 / 8 / 12 / 16 / 24 / 32 / 48. Yuvarlaklık (iç içe: üst - dolgu): pencere içi kart 16, düğme 10-12, satır 8, hap = yüksekliğin yarısı.
         Bütün fırçalar donuk (po:Freeze): animasyon yalnızca Opacity ve dönüşümlerle yapılır.
         ===================================================================================== -->

    <!-- yüzeyler -->
    <Color x:Key="BgColor">#121318</Color>
    <Color x:Key="RailColor">#171920</Color>
    <Color x:Key="SurfaceColor">#1D2028</Color>
    <Color x:Key="RaisedColor">#252933</Color>
    <Color x:Key="HairlineColor">#2E333F</Color>
    <Color x:Key="ControlEdgeColor">#666E82</Color>
    <!-- yazı -->
    <Color x:Key="TextColor">#ECEEF4</Color>
    <Color x:Key="Text2Color">#CBD0DC</Color>
    <Color x:Key="Text3Color">#9AA1B4</Color>
    <!-- vurgu -->
    <Color x:Key="AccentColor">#A9B3FF</Color>
    <Color x:Key="AccentHoverColor">#BCC4FF</Color>
    <Color x:Key="AccentPressColor">#98A3F5</Color>
    <Color x:Key="OnAccentColor">#10121A</Color>
    <!-- durum -->
    <Color x:Key="GoodColor">#5FD3A0</Color>
    <Color x:Key="WarnColor">#F2B94B</Color>
    <Color x:Key="BadColor">#FF7A7A</Color>

    <!-- düz fırçalar (metin, çizgi, durum) -->
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlEdgeBrush" Color="{StaticResource ControlEdgeColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="{StaticResource AccentPressColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" po:Freeze="True"/>

    <!-- yarı saydam katmanlar -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24A9B3FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#1FF2B94B" po:Freeze="True"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="#26FF7A7A" po:Freeze="True"/>
    <SolidColorBrush x:Key="HoverVeilBrush" Color="#0DFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PressVeilBrush" Color="#16FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#B30A0B10" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0E1016" po:Freeze="True"/>
    <SolidColorBrush x:Key="TickDimBrush" Color="#2A2E3D" po:Freeze="True"/>
    <SolidColorBrush x:Key="TickMajorBrush" Color="#474E63" po:Freeze="True"/>

    <!-- ==================== degradeler ==================== -->
    <!-- pencere: ortası bir tık açık; kanal adımları farklı yerlerde olsun diye (bantlaşma) R/G/B farkları ayrı -->
    <RadialGradientBrush x:Key="BgBrush" Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.9" RadiusY="0.75" po:Freeze="True">
        <GradientStop Color="#191B27" Offset="0"/>
        <GradientStop Color="#14161E" Offset="0.55"/>
        <GradientStop Color="#101116" Offset="1"/>
    </RadialGradientBrush>

    <!-- sol çubuk ve Ayrıntılar paneli: pencereden bir basamak açık -->
    <LinearGradientBrush x:Key="RailBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#1B1D2A" Offset="0"/>
        <GradientStop Color="#14161F" Offset="1"/>
    </LinearGradientBrush>

    <!-- kart yüzeyi ve kenarı -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0.7,1" po:Freeze="True">
        <GradientStop Color="#1D2030" Offset="0"/>
        <GradientStop Color="#161822" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RimBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#55B8C0FF" Offset="0"/>
        <GradientStop Color="#1AA9B3FF" Offset="0.45"/>
        <GradientStop Color="#0A8C96E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RimHoverBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#88B8C0FF" Offset="0"/>
        <GradientStop Color="#33A9B3FF" Offset="0.5"/>
        <GradientStop Color="#188C96E8" Offset="1"/>
    </LinearGradientBrush>
    <!-- kartın üstündeki ince ışık çizgisi ve yumuşak ışık lekesi -->
    <LinearGradientBrush x:Key="TopLightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#38FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="CardWashBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.6" po:Freeze="True">
        <GradientStop Color="#14A9B3FF" Offset="0"/>
        <GradientStop Color="#00A9B3FF" Offset="1"/>
    </RadialGradientBrush>

    <!-- yükseltilmiş yüzey (düğme, seçili bölme) -->
    <LinearGradientBrush x:Key="RaisedBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#2B3046" Offset="0"/>
        <GradientStop Color="#212534" Offset="1"/>
    </LinearGradientBrush>
    <!-- seçili bölme: soluk lavanta cam -->
    <LinearGradientBrush x:Key="SelectedFillBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#443F4780" Offset="0"/>
        <GradientStop Color="#552B3068" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRimBrush" Color="#66A9B3FF" po:Freeze="True"/>
    <LinearGradientBrush x:Key="SelectedGlowBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#00A9B3FF" Offset="0"/>
        <GradientStop Color="#33A9B3FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ana eylem rengi: açıktan koyuya lavanta; anahtarlar, birincil düğme -->
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#C9CFFF" Offset="0"/>
        <GradientStop Color="#98A3FA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillHoverBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#D8DCFF" Offset="0"/>
        <GradientStop Color="#A9B3FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillPressBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#B3BBFA" Offset="0"/>
        <GradientStop Color="#8892EC" Offset="1"/>
    </LinearGradientBrush>

    <!-- Başlat küresi: sol üstte ışık, sağ altta çivit; üstünde ince cam kenar ve parlama -->
    <RadialGradientBrush x:Key="OrbBrush" Center="0.5,0.5" GradientOrigin="0.35,0.25" RadiusX="0.9" RadiusY="0.9" po:Freeze="True">
        <GradientStop Color="#DDE1FF" Offset="0"/>
        <GradientStop Color="#A9B3FF" Offset="0.45"/>
        <GradientStop Color="#6F76F2" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbHoverBrush" Center="0.5,0.5" GradientOrigin="0.35,0.25" RadiusX="0.9" RadiusY="0.9" po:Freeze="True">
        <GradientStop Color="#EAEDFF" Offset="0"/>
        <GradientStop Color="#B8C0FF" Offset="0.45"/>
        <GradientStop Color="#7C83F7" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbPressBrush" Center="0.5,0.5" GradientOrigin="0.35,0.25" RadiusX="0.9" RadiusY="0.9" po:Freeze="True">
        <GradientStop Color="#C9CFFF" Offset="0"/>
        <GradientStop Color="#98A3F5" Offset="0.45"/>
        <GradientStop Color="#5F66DE" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="OrbRimBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#AAFFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.3"/>
        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        <GradientStop Color="#33000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrbSpecularBrush" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#55FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- durum başlığı: beyazdan lavantaya -->
    <LinearGradientBrush x:Key="HeadlineBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#C3CAFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ışıma: halkanın arkasındaki ışık. Yumuşak kuyruk için 5 durak (smoothstep); bitiş aynı RGB, alfa 0 (gri kenar kalmasın).
         Işık halkayla birlikte durum rengine döner (VM seçer: Halo + Accent / Good / Warn / Bad). -->
    <RadialGradientBrush x:Key="HaloAccent" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#1FA9B3FF" Offset="0"/>
        <GradientStop Color="#33A9B3FF" Offset="0.6"/>
        <GradientStop Color="#40A9B3FF" Offset="0.74"/>
        <GradientStop Color="#14A9B3FF" Offset="0.88"/>
        <GradientStop Color="#00A9B3FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HaloGood" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#1F5FD3A0" Offset="0"/>
        <GradientStop Color="#335FD3A0" Offset="0.6"/>
        <GradientStop Color="#405FD3A0" Offset="0.74"/>
        <GradientStop Color="#145FD3A0" Offset="0.88"/>
        <GradientStop Color="#005FD3A0" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HaloWarn" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#1FF2B94B" Offset="0"/>
        <GradientStop Color="#33F2B94B" Offset="0.6"/>
        <GradientStop Color="#40F2B94B" Offset="0.74"/>
        <GradientStop Color="#14F2B94B" Offset="0.88"/>
        <GradientStop Color="#00F2B94B" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HaloBad" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#1FFF7A7A" Offset="0"/>
        <GradientStop Color="#33FF7A7A" Offset="0.6"/>
        <GradientStop Color="#40FF7A7A" Offset="0.74"/>
        <GradientStop Color="#14FF7A7A" Offset="0.88"/>
        <GradientStop Color="#00FF7A7A" Offset="1"/>
    </RadialGradientBrush>
    <!-- eski ad (başka yerlerde kullanılıyor olabilir) -->
    <RadialGradientBrush x:Key="RingGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#2EA9B3FF" Offset="0"/>
        <GradientStop Color="#00A9B3FF" Offset="1"/>
    </RadialGradientBrush>

    <!-- kutup ışığı: pencerenin arkasındaki üç yumuşak leke (çivit ailesi, en çok %22). Her biri 5 duraklı yumuşak kuyruk -->
    <RadialGradientBrush x:Key="AuroraA" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#387C6CFF" Offset="0"/>
        <GradientStop Color="#2F7C6CFF" Offset="0.25"/>
        <GradientStop Color="#1C7C6CFF" Offset="0.5"/>
        <GradientStop Color="#097C6CFF" Offset="0.75"/>
        <GradientStop Color="#007C6CFF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraB" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#26A9B3FF" Offset="0"/>
        <GradientStop Color="#20A9B3FF" Offset="0.25"/>
        <GradientStop Color="#13A9B3FF" Offset="0.5"/>
        <GradientStop Color="#06A9B3FF" Offset="0.75"/>
        <GradientStop Color="#00A9B3FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraC" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#2E4F46E5" Offset="0"/>
        <GradientStop Color="#274F46E5" Offset="0.25"/>
        <GradientStop Color="#174F46E5" Offset="0.5"/>
        <GradientStop Color="#074F46E5" Offset="0.75"/>
        <GradientStop Color="#004F46E5" Offset="1"/>
    </RadialGradientBrush>

    <!-- Ayrıntılar panelinin solunda düşen yumuşak gölge (Effect yerine 28 px'lik degrade şerit) -->
    <LinearGradientBrush x:Key="DrawerShadowBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#18000000" Offset="0.6"/>
        <GradientStop Color="#55000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- yazı tipleri: yalnızca Windows'la gelenler. Bahnschrift yoksa Segoe UI Variable Display'e düşer -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI Variable Display, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
