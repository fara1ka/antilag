<Window x:Class="CS2Hazirla.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antilag" Width="500" SizeToContent="Height" MinWidth="380" MaxHeight="640" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        xml:lang="tr-TR" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,26,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                <Ellipse x:Name="IconBack" Fill="{StaticResource AccentSoftBrush}"/>
                <Path x:Name="IconPath" Style="{StaticResource Icon}" Data="{StaticResource IconAlert}" Width="17" Height="17" HorizontalAlignment="Center"
                      TextElement.Foreground="{StaticResource AccentBrush}"/>
            </Grid>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" FontSize="19" TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <StackPanel x:Name="ButtonRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"/>
    </Grid>
</Window>
