<Window x:Class="CS2Hazirla.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Önizleme" Width="820" Height="720" MinWidth="640" MinHeight="500"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14" TextOptions.TextFormattingMode="Display"
        xml:lang="tr-TR" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Önizleme" Style="{StaticResource Heading}" FontSize="24"/>
            <TextBlock Text="{Binding Header}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Background="{StaticResource WarnSoftBrush}" CornerRadius="10" Padding="16,12"
                Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}">
            <ItemsControl ItemsSource="{Binding Warnings}" TextElement.Foreground="{StaticResource WarnBrush}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" LineHeight="19" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,4,-8,0" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitle}" Margin="2,22,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Rectangle x:Name="Sep" Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- ad ve açıklama da onay kutusunun içinde: satırın tamamı (üst ve alt boşluk dahil) tıklanır, yalnızca küçük kutu değil -->
                                                <CheckBox Grid.ColumnSpan="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,14,0" Padding="0,10"
                                                          AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding NeverAddedText}" Style="{StaticResource Hint}" HorizontalAlignment="Right" Margin="0,3,9,0"
                                                               Visibility="{Binding NeverAdded, Converter={StaticResource B2V}}"/>
                                                    <Button Content="{Binding NeverText}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                                            Command="{Binding NeverCommand}" Visibility="{Binding CanNever, Converter={StaticResource B2V}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <!-- the button is declared first: a DockPanel measures in order, so a long sentence can never squeeze it out at the smallest window -->
            <Button DockPanel.Dock="Right" Content="Tamam" Padding="30,10" IsDefault="True" IsCancel="True" Click="Ok_Click" Style="{StaticResource PrimaryButton}"/>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Hint}" MaxWidth="480" Margin="0,0,16,0"
                       Text="İşaretini kaldırdığın şey yalnızca bu seferlik yapılmaz. 'Her zaman açık kalsın' kalıcıdır; Ayarlar'dan çıkarılır."/>
        </DockPanel>
    </Grid>
</Window>
