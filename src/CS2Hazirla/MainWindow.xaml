<Window x:Class="CS2Hazirla.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CS2Hazirla"
        Title="Antilag" Width="1120" Height="760" MinWidth="940" MinHeight="620"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        xml:lang="tr-TR" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- bir anahtar satırı: yalnızca ad. Ad kendi başına anlaşılmıyorsa gri bir ipucu; gerçek bir risk varsa sarı bir uyarı -->
        <DataTemplate x:Key="OptionRowTemplate">
            <StackPanel>
                <Rectangle x:Name="Sep" Style="{StaticResource Hairline}" Margin="20,0"/>
                <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding IsOn, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Caution}"
                          IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="{Binding HasHint, Converter={StaticResource B2V}}"/>
                        <Grid Margin="0,4,0,0" Visibility="{Binding HasCaution, Converter={StaticResource B2V}}" TextElement.Foreground="{StaticResource WarnBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconAlert}" Width="14" Height="14" Margin="0,1,7,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding Caution}" FontSize="12.5" LineHeight="17" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ana ekran listesindeki satır: yalnızca ad ve anahtar -->
        <DataTemplate x:Key="HomeAppRow">
            <StackPanel>
                <Rectangle x:Name="Sep" Style="{StaticResource Hairline}" Margin="14,0"/>
                <CheckBox Style="{StaticResource SwitchRow}" Padding="14,6" MinHeight="44" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanSwitch}"
                          AutomationProperties.Name="{Binding Title}">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                </CheckBox>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="OptionGroupTemplate">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitle}" Margin="20,20,0,6"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource OptionRowTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <!-- hazır ayar ya da profil seçeneği (ana ekrandaki şerit ve Ayrıntılar'daki şerit aynı şablonu kullanır). GroupName yok: seçili olan sanal modelden gelir -->
        <DataTemplate x:Key="ChipTemplate">
            <RadioButton Content="{Binding Name}" Style="{StaticResource Segment}" HorizontalAlignment="Stretch" Padding="10,11" IsChecked="{Binding IsActive, Mode=TwoWay}"
                         IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>

        <!-- halkanın ortasındaki düğmeler: duruma uyan görünür -->
        <Style x:Key="HeroPrepare" TargetType="Button" BasedOn="{StaticResource HeroButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeroClose" TargetType="Button" BasedOn="{StaticResource HeroButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnlyWhenDone" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HiddenWhenDone" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ arka plan ışığı: üç yumuşak leke (çivit ailesi) + ince dither dokusu. Durağan; bir kez çizilip önbelleğe alınır, hiçbir şey hareket etmez ============ -->
        <Grid x:Name="Atmosphere" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True" CacheMode="BitmapCache">
            <Rectangle Width="980" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,-300,0,0" Fill="{StaticResource AuroraA}"/>
            <Rectangle Width="820" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,-300,0" Fill="{StaticResource AuroraB}"/>
            <Rectangle Width="1200" Height="640" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="216,0,0,-340" Fill="{StaticResource AuroraC}"/>
            <Rectangle x:Name="Grain"/>
        </Grid>

        <!-- ============ sol çubuk: üç hedef + uygulamayı kapat ============ -->
        <Border x:Name="RailHost" Grid.Column="0" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,24,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,0,0,26">
                    <StackPanel Orientation="Horizontal">
                        <local:TickRing Width="30" Height="30" TickCount="16" Progress="0.75" TickLength="0.42" TickThickness="0.13"
                                        LitBrush="{StaticResource AccentBrush}" DimBrush="{StaticResource TickMajorBrush}" Margin="0,0,12,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Antilag" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource HeadlineBrush}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" LineHeight="16" Margin="0,10,6,0"
                               Text="Input lag'ı azaltmak için tasarlanmıştır. Arka planda çalışan gereksiz uygulamaları kapatır."/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource RailItem}" GroupName="page" IsChecked="{Binding PageHome, Mode=TwoWay}" AutomationProperties.Name="Ana ekran">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconHome}" Margin="0,0,12,0"/>
                            <TextBlock Text="Ana ekran"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailItem}" GroupName="page" IsChecked="{Binding PageProfiles, Mode=TwoWay}" AutomationProperties.Name="Profiller" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconProfile}" Margin="0,0,12,0"/>
                            <TextBlock Text="Profiller"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <!-- yeni sürüm bildirimi: yalnızca bir sürüm bulununca görünür; ana ekranın düzenine dokunmaz -->
                    <Border x:Name="UpdateCard" DataContext="{Binding Update}" Visibility="{Binding Show, Converter={StaticResource B2V}}"
                            Margin="0,0,0,14" Padding="13,12" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HeadlineBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="12" LineHeight="16" Margin="0,3,0,0"/>
                            <Border Visibility="{Binding ShowProgress, Converter={StaticResource B2V}}" Height="4" CornerRadius="2" Margin="0,10,0,0"
                                    Background="{StaticResource HairlineBrush}" ClipToBounds="True">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress}"/></Border.RenderTransform>
                                </Border>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0" Visibility="{Binding ShowButtons, Converter={StaticResource B2V}}">
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding InstallText}" Command="{Binding InstallCommand}" Padding="14,6" MinHeight="32" FontSize="12.5"/>
                                <Button Style="{StaticResource TextButton}" Content="{Binding DismissText}" Command="{Binding DismissCommand}" Margin="4,0,0,0" Padding="10,6" MinHeight="32" FontSize="12.5"/>
                            </StackPanel>
                            <Button Style="{StaticResource TextButton}" Content="Vazgeç" Command="{Binding CancelCommand}" Visibility="{Binding ShowCancel, Converter={StaticResource B2V}}"
                                    HorizontalAlignment="Left" Margin="-10,8,0,0" Padding="10,6" MinHeight="32" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <RadioButton Style="{StaticResource RailItem}" GroupName="page" IsChecked="{Binding PageSettings, Mode=TwoWay}" AutomationProperties.Name="Ayarlar">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSliders}" Margin="0,0,12,0"/>
                            <TextBlock Text="Ayarlar"/>
                        </StackPanel>
                    </RadioButton>
                    <Rectangle Style="{StaticResource Hairline}" Margin="6,12,6,10"/>
                    <Button Style="{StaticResource TextButton}" Command="{Binding CloseAppCommand}" HorizontalContentAlignment="Left" Padding="14,12"
                            ToolTip="Uygulamayı tamamen kapatır; arkada çalışan hiçbir şey kalmaz. Yaptığın değişiklikler yerinde durur.">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconPower}" Margin="0,0,12,0"/>
                            <TextBlock Text="Uygulamayı kapat"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ içerik ============ -->
        <Grid Grid.Column="1" x:Name="ContentHost">

            <!-- imza: en sağ altta, çok küçük; sayfaların ve Ayrıntılar panelinin altında kalır, tıklanmaz -->
            <TextBlock Text="created by claude via fara1k" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8"
                       FontSize="10" Foreground="{StaticResource Text3Brush}" Opacity="0.8" IsHitTestVisible="False" Focusable="False"/>

            <!-- ana ekran: tek büyük halka, altında durum ve birkaç düğme -->
            <ScrollViewer x:Name="MainPage" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageHome, Converter={StaticResource B2V}}" Focusable="False">
                <StackPanel MaxWidth="900" Margin="24,40,24,28" HorizontalAlignment="Center" VerticalAlignment="Top">

                    <Border x:Name="AdminBadge" Style="{StaticResource Chip}" Background="{StaticResource BadSoftBrush}" Visibility="Collapsed" Padding="12,5"
                            HorizontalAlignment="Center" Margin="0,-6,0,10">
                        <TextBlock Text="Yönetici değil: bazı işlemler başarısız olur" Foreground="{StaticResource BadBrush}" FontSize="12.5"/>
                    </Border>

                    <!-- geniş pencerede iki sütun (solda dial ve durum, sağda ayar seçimi + ayrıntı kartı), dar pencerede alt alta (HomeLayout, kod tarafında) -->
                    <Grid x:Name="HomeGrid" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <StackPanel x:Name="LeftCol" Width="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">

                    <!-- dış kutu ışımayı taşıyacak kadar büyük; eksi kenar boşluğu sayfadaki yerini halka kadar tutar (yoksa ışıma kırpılır).
                         HeroHalo: halkanın arkasındaki ışık; durum rengini alır, hazırken yavaşça "nefes alır" (Breathing) -->
                    <Grid x:Name="IntroRing" Width="330" Height="330" HorizontalAlignment="Center" Margin="0,-48">
                        <Ellipse x:Name="HeroHalo" Fill="{Binding RingHaloBrush}" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Grid Width="240" Height="240">
                            <local:TickRing Progress="{Binding RingProgress}" Sweeping="{Binding RingSweeping}" LitBrush="{Binding RingBrush}"
                                            DimBrush="{StaticResource TickDimBrush}" MajorBrush="{StaticResource TickMajorBrush}" IsHitTestVisible="False"/>
                            <Button Style="{StaticResource HeroPrepare}" Command="{Binding PrepareCommand}" AutomationProperties.Name="Başlat"
                                    ToolTip="Seçilen programları kapatır ve ayarları uygular. Neler yapıldığı aşağıda satır satır görünür.">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HeroLabel}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               TextOptions.TextFormattingMode="Ideal"/>
                                    <TextBlock Text="{Binding StepText}" FontSize="13" HorizontalAlignment="Center" Margin="0,1,0,0" Opacity="0.8"
                                               Visibility="{Binding HasSteps, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroClose}" Command="{Binding CloseAppCommand}" AutomationProperties.Name="Uygulamayı kapat"
                                    ToolTip="Uygulamayı tamamen kapatır; arkada hiçbir şey çalışmaya devam etmez. Sonra CS2'yi sen aç.">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPower}" Width="30" Height="30" StrokeThickness="2" HorizontalAlignment="Center"/>
                                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" TextAlignment="Center" HorizontalAlignment="Center">
                                        <Run Text="Uygulamayı"/><LineBreak/><Run Text="kapat"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="IntroTitle" Text="{Binding HeroTitle}" Style="{StaticResource StateWord}" Foreground="{Binding HeroBrush}" Margin="0,26,0,0"
                               TextOptions.TextFormattingMode="Ideal" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="IntroHint" Text="{Binding HeroHint}" Style="{StaticResource Body2}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="290" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasHeroHint, Converter={StaticResource B2V}}"/>

                    <!-- işlem bittikten sonra, büyük düğmenin baya altında: kapatılan uygulamaları geri açar (Başlat'tan küçük). Yer ayrılmıştır (Hidden), görününce halka yerinden oynamaz -->
                    <Button x:Name="IntroRestore" Command="{Binding RevertCommand}" HorizontalAlignment="Center" Margin="0,76,0,0" Padding="16,8" MinHeight="34" FontSize="13" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding RestoreTip}"
                            AutomationProperties.Name="{Binding RestoreLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRestore}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRestore}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding RestoreLabel}"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <!-- sağ sütun üstten hizalı: ayar şeridi hangi ayar seçilirse seçilsin aynı yerde durur (kart uzayıp kısalınca tıklanacak yer kaymaz) -->
                    <StackPanel x:Name="RightCol" Grid.Column="1" Width="500" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,0,0,0">

                    <!-- hazır ayarlar ve kendi profillerin tek şeritte: eşit genişlikte 3 sütun, profiller alt satırlara akar -->
                    <Border x:Name="IntroChips" Style="{StaticResource GlassPill}" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False" KeyboardNavigation.TabNavigation="Once">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <!-- bilgisayarda şu an açık olan, kapatılabilecek tanıdık programlar (açılışta kısa bir tarama): her biri bir anahtar.
                         Seçili ayar anahtarların nasıl başladığını söyler, bir tıklama yalnızca o programı değiştirir. Çalışırken ve bittikten sonra gizlenir -->
                    <ContentControl x:Name="IntroCard" Style="{StaticResource GlassCard}" Margin="0,14,0,0" Padding="8,12,8,8"
                                    Visibility="{Binding ShowModeCard, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <Grid Margin="14,0,6,2">
                                <TextBlock Text="Kapatılacak uygulamalar" Style="{StaticResource GroupTitle}" VerticalAlignment="Center"/>
                                <TextBlock Text="taranıyor…" Foreground="{StaticResource AccentBrush}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsScanning, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding RescanCommand}" HorizontalAlignment="Right" Width="36" Height="36" MinHeight="0"
                                        AutomationProperties.Name="Yeniden tara" ToolTip="Yeniden tara"
                                        Visibility="{Binding IsScanning, Converter={StaticResource NotB2V}}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                            <ScrollViewer x:Name="HomeListScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding HomeRows}" ItemTemplate="{StaticResource HomeAppRow}" IsTabStop="False" AutomationProperties.Name="Kapatılacak uygulamalar"/>
                            </ScrollViewer>
                            <TextBlock Text="Kapatılabilecek büyük bir uygulama bulunamadı." Style="{StaticResource Hint}" Margin="14,10,14,12"
                                       Visibility="{Binding ShowNoApps, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </ContentControl>

                    <!-- yapılanlar: ilk çalıştırmaya kadar hiç görünmez. Sağ sütunda, kartın yerinde (çalışırken ve bittikten sonra) durur -->
                    <Border x:Name="IntroLog" Margin="0,14,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1" CornerRadius="16"
                            Visibility="{Binding ShowLog, Converter={StaticResource B2V}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="20,14,20,0">
                                <TextBlock Text="Neler yapıldı" Style="{StaticResource GroupTitle}"/>
                                <TextBlock Text="çalışıyor…" Foreground="{StaticResource AccentBrush}" FontSize="12.5" HorizontalAlignment="Right"
                                           Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                            </Grid>
                            <ScrollViewer x:Name="LogScroll" Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto" Padding="20,8,8,14">
                                <ItemsControl x:Name="LogList" ItemsSource="{Binding LogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- işaret | ileti | saat: işaret ve renk birlikte anlatır -->
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Prefix}" Foreground="{Binding PrefixBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding TextBrush}" FontSize="13" LineHeight="18" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{StaticResource Text3Brush}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           Margin="10,3,0,0" VerticalAlignment="Top"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <WrapPanel x:Name="IntroButtons" HorizontalAlignment="Left" Margin="-8,10,0,0">
                        <Button x:Name="DetailsButton" Style="{StaticResource TextButton}" Command="{Binding ToggleDrawerCommand}" Margin="0,0,4,0"
                                ToolTip="Neyin kapanacağını ve hangi ayarların yapılacağını tek tek göster">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconList}" Margin="0,0,9,0"/>
                                <TextBlock Text="Ayrıntılar"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HiddenWhenDone}" Command="{Binding PreviewCommand}" Margin="0,0,4,0"
                                ToolTip="Hiçbir şey yapmadan, şu an nelerin kapanacağını listeler.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconEye}" Margin="0,0,9,0"/>
                                <TextBlock Text="Önizleme"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OnlyWhenDone}" Command="{Binding PrepareCommand}" Margin="0,0,4,0"
                                ToolTip="Önceki çalıştırmanın ayarlarını geri alıp temizliği baştan yapar.">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconRestore}" Margin="0,0,9,0"/>
                                <TextBlock Text="Tekrar çalıştır"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- profiller -->
            <Grid x:Name="ProfilesPage" Visibility="{Binding PageProfiles, Converter={StaticResource B2V}}" IsEnabled="{Binding IsIdle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,32,24,24">
                            <TextBlock Text="Profiller" Style="{StaticResource Heading}" FontSize="26"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,20"
                                       Text="Ayarlarını bir profil olarak kaydet. Ana ekranda profili seçip Başlat'a basınca o ayarlarla çalışır."/>
                            <ItemsControl ItemsSource="{Binding SavedProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="savedProfiles" Style="{StaticResource RailItem}" Margin="0,0,0,4" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource Chip}" Background="{StaticResource AccentSoftBrush}" Margin="8,0,0,0"
                                                        Visibility="{Binding InUse, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="seçili" Foreground="{StaticResource AccentBrush}" FontSize="11.5"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Henüz profilin yok." Style="{StaticResource Hint}" Visibility="{Binding HasNoProfiles, Converter={StaticResource B2V}}"/>
                            <Button Style="{StaticResource TextButton}" Command="{Binding NewProfileCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Margin="0,0,9,0"/>
                                    <TextBlock Text="Yeni profil"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock Text="Soldan bir profil seç ya da yeni bir profil oluştur." Margin="40,36,40,0" VerticalAlignment="Top" TextWrapping="Wrap" Style="{StaticResource Hint}"
                                   Visibility="{Binding HasEditing, Converter={StaticResource NotB2V}}"/>

                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="40,32,32,36" Visibility="{Binding HasEditing, Converter={StaticResource B2V}}">
                            <TextBlock Text="Profilin adı" Style="{StaticResource GroupTitle}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Tag="Profil adı" Width="360" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Profilin adı"/>

                            <TextBlock Text="Başlangıç noktası" Style="{StaticResource GroupTitle}" Margin="0,22,0,8"/>
                            <Border Style="{StaticResource GlassPill}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Hafif" Style="{StaticResource Segment}" GroupName="editBase" IsChecked="{Binding EditBaseSafe, Mode=TwoWay}"/>
                                    <RadioButton Content="Tam temizlik" Style="{StaticResource Segment}" GroupName="editBase" IsChecked="{Binding EditBaseMax, Mode=TwoWay}"/>
                                    <RadioButton Content="Yayıncı" Style="{StaticResource Segment}" GroupName="editBase" IsChecked="{Binding EditBaseStream, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,26,0,0">
                                <Button Content="Bu profili seç" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Command="{Binding UseProfileCommand}"
                                        ToolTip="Kaydeder ve ana ekrana döner; Başlat'a basınca bu profildeki ayarlarla çalışır."/>
                                <Button Content="Kaydet" Margin="0,0,10,0" Command="{Binding SaveProfileCommand}"/>
                                <!-- silme: pencere açılmaz, düğme yerinde bir soruya döner -->
                                <Button Content="Profili sil" Style="{StaticResource TextButton}" Foreground="{StaticResource BadBrush}" Command="{Binding AskDeleteCommand}"
                                        Visibility="{Binding ConfirmingDelete, Converter={StaticResource NotB2V}}"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingDelete, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Silinsin mi?" VerticalAlignment="Center" Margin="4,0,10,0"/>
                                    <Button Content="Evet, sil" Margin="0,0,6,0" Command="{Binding ConfirmDeleteCommand}" Foreground="{StaticResource BadBrush}"/>
                                    <Button Content="Vazgeç" Style="{StaticResource TextButton}" Command="{Binding CancelDeleteCommand}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding EditStatus}" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="2,10,0,0"/>

                            <TextBlock Text="Bu profilde neler kapansın?" Style="{StaticResource Heading}" FontSize="17" Margin="0,28,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4" Text="Anahtarı açık olanlar, bu profille Başlat'a basınca yapılır. Kaydet'e basınca profile yazılır."/>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1" CornerRadius="16" Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding EditGroups}" ItemTemplate="{StaticResource OptionGroupTemplate}" Margin="0,0,0,4"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ayarlar -->
            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageSettings, Converter={StaticResource B2V}}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="40,32,32,40" IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Ayarlar" Style="{StaticResource Heading}" FontSize="26"/>
                    <!-- liste düğmelerine CS2 çalışırken basılırsa hiçbir şey olmaz; bu satır nedenini söyler -->
                    <Border Background="{StaticResource BadSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding GameRunning, Converter={StaticResource B2V}}">
                        <TextBlock Text="CS2 çalışıyor: oyun açıkken Antilag hiçbir şey yapmaz; bu sayfadaki liste düğmeleri oyun kapanınca çalışır."
                                   Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Her şey listeden seçilir; bir şey yazman gerekmez. Değişiklikler kendiliğinden kaydedilir."/>

                    <local:AppListCard DataContext="{Binding KeepOpenList}" Margin="0,28,0,0"/>
                    <local:AppListCard DataContext="{Binding AlwaysCloseList}" Margin="0,28,0,0"/>

                    <Rectangle Style="{StaticResource Hairline}" Margin="0,28,0,0"/>
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding RestartClosedApps, Mode=TwoWay}" Padding="0,14"
                              AutomationProperties.Name="Kapattığım programları geri açsın">
                        <StackPanel>
                            <TextBlock Text="Kapattığım programları geri açsın" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Kapalıyken geri yükleme yalnızca ayarları ve hizmetleri eski haline getirir. Kendini güncelleyen programlar, arka plan yardımcıları, engel aşma programları ve Mağaza uygulamaları açılamaz; hangileri açılmadıysa sonunda adlarıyla yazılır."/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Style="{StaticResource Hairline}"/>
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Update.CheckForUpdates, Mode=TwoWay}" Padding="0,14"
                              AutomationProperties.Name="Yeni sürüm olunca haber ver">
                        <StackPanel>
                            <TextBlock Text="Yeni sürüm olunca haber ver" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Antilag açılırken GitHub'dan yalnızca en yeni sürüm numarasına bakar; hesap, program listesi ya da dosya bilgisi göndermez (GitHub, her internet isteğinde olduğu gibi IP adresini görür). Kapalıyken kendiliğinden istek yapılmaz; Şimdi denetle yine çalışır. İndirme ve kurulum yalnızca sen Güncelle'ye basınca olur."/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Style="{StaticResource Hairline}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Update.VersionLine}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Şimdi denetle" Style="{StaticResource TextButton}" Command="{Binding Update.CheckNowCommand}" Padding="12,7" MinHeight="36"/>
                    </Grid>

                    <TextBlock Text="Geçici durdurulacak Windows hizmetleri" Style="{StaticResource Heading}" FontSize="16" Margin="0,28,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="Yalnızca durdurulur, silinmez; bilgisayarı yeniden başlatınca ya da geri yüklenince geri gelir."/>
                    <ItemsControl ItemsSource="{Binding ServiceRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Rectangle x:Name="Sep" Style="{StaticResource Hairline}"/>
                                    <Grid Margin="0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- yazı da onay kutusunun içinde: satırın tamamı (kutu + ad + açıklama) tıklanır -->
                                        <CheckBox Grid.ColumnSpan="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Plain}" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <Button Grid.Column="2" Content="Çıkar" Style="{StaticResource LinkButton}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title, StringFormat='Çıkar: {0}'}"
                                                Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource TextButton}" Command="{Binding AddServiceCommand}" HorizontalAlignment="Left" Margin="-12,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Margin="0,0,9,0"/>
                            <TextBlock Text="Listeden hizmet seç"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource Hairline}" Margin="0,24,0,0"/>
                    <TextBlock Text="Her zaman korunanlar" FontSize="14.5" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Bunlar bilgisayarın ve oyunun çalışması için şart olduğundan hiçbir ayarla kapanmaz: CS2 ve Steam, FACEIT, Windows'un kendi parçaları, Windows Defender, ekran kartı ve ses kartı sürücüleri."/>

                    <Rectangle Style="{StaticResource Hairline}" Margin="0,24,0,0"/>
                    <TextBlock Text="Hakkında" FontSize="14.5" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding Update.AboutText}"/>
                    <StackPanel Orientation="Horizontal" Margin="-12,6,0,0">
                        <Button Style="{StaticResource TextButton}" Content="Kaynak kod" Command="{Binding Update.OpenSourceCommand}" Padding="12,7" MinHeight="36"/>
                        <Button Style="{StaticResource TextButton}" Content="Lisans ve bildirimler" Command="{Binding Update.OpenLicensesCommand}" Padding="12,7" MinHeight="36"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Ayrıntılar paneli: sağdan açılır, ana ekran kararır -->
            <Border x:Name="Scrim" Background="{StaticResource ScrimBrush}" Visibility="{Binding PageHome, Converter={StaticResource B2V}}" MouseLeftButtonDown="Scrim_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DrawerOpen}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="True"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource D25}"/></Storyboard></BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource D16}"/></Storyboard></BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Border x:Name="DrawerPanel" Width="440" HorizontalAlignment="Right" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding PageHome, Converter={StaticResource B2V}}">
                <Border.RenderTransform><TranslateTransform X="56"/></Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DrawerOpen}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="True"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource D25}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource D25}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource D16}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="56" Duration="{StaticResource D16}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- panelin solunda düşen yumuşak gölge (efekt değil, degrade şerit; panelle birlikte kayar ve belirir) -->
                    <Rectangle Grid.RowSpan="4" Width="28" HorizontalAlignment="Left" Margin="-29,0,0,0" Fill="{StaticResource DrawerShadowBrush}" IsHitTestVisible="False"/>

                    <Grid Margin="24,20,10,0">
                        <StackPanel>
                            <TextBlock Text="Ayrıntılar" Style="{StaticResource Heading}"/>
                            <TextBlock Text="Seçimler, Başlat'a bastığında uygulanır." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Command="{Binding CloseDrawerCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Ayrıntıları kapat">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                        </Button>
                    </Grid>

                    <!-- hangi hazır ayarın / profilin ayrıntılarına bakıldığı: buradan değiştirilir, liste hemen o ayara göre güncellenir -->
                    <!-- yalnızca seçimlerin göründüğü sekmelerde; çok profil olsa da en fazla iki satır yer kaplar, fazlası kaydırılır -->
                    <Border Grid.Row="1" Style="{StaticResource GlassPill}"
                            Margin="24,16,24,0" HorizontalAlignment="Stretch" Visibility="{Binding ShowSelections, Converter={StaticResource B2V}}">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False" KeyboardNavigation.TabNavigation="Once">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,6,24,0">
                        <RadioButton Content="Özet" Style="{StaticResource PanelTab}" GroupName="drawertab" IsChecked="{Binding TabSummary, Mode=TwoWay}"/>
                        <RadioButton Content="Tam liste" Style="{StaticResource PanelTab}" GroupName="drawertab" IsChecked="{Binding TabFull, Mode=TwoWay}"/>
                        <RadioButton Content="Ölçümler" Style="{StaticResource PanelTab}" GroupName="drawertab" IsChecked="{Binding TabMetrics, Mode=TwoWay}"/>
                        <RadioButton Content="Bellek" Style="{StaticResource PanelTab}" GroupName="drawertab" IsChecked="{Binding TabMemory, Mode=TwoWay}"/>
                    </StackPanel>
                    <Rectangle Grid.Row="2" Style="{StaticResource Hairline}" VerticalAlignment="Bottom"/>

                    <!-- özet (yalnızca programlar) ve tam liste (her şey): ikisinde de yalnızca ad (+ gerekirse kısa ipucu) ve arama kutusu -->
                    <Grid Grid.Row="3" Visibility="{Binding ShowSelections, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="24,14,24,6">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Program ya da ayar ara…" Padding="12,8,38,8"
                                 AutomationProperties.Name="Ayrıntılarda ara"/>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" MinHeight="0" Margin="0,0,2,0"
                                AutomationProperties.Name="Aramayı temizle" Visibility="{Binding HasSearch, Converter={StaticResource B2V}}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" Width="13" Height="13"/>
                        </Button>
                    </Grid>
                    <ScrollViewer x:Name="SelectionScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="Eşleşen bir şey yok. Başka bir sözcük dene. CS2, Steam, Windows parçaları ve “Her zaman açık kalsın” listendeki programlar hiçbir ayarda kapanmaz; o yüzden burada çıkmaz."
                                       Style="{StaticResource Hint}" Margin="24,14,24,0" Visibility="{Binding HasNoResults, Converter={StaticResource B2V}}"/>
                            <ItemsControl ItemsSource="{Binding ShownGroups}" ItemTemplate="{StaticResource OptionGroupTemplate}"/>
                            <TextBlock Text="Windows hizmetleri, Windows ayarları ve internet ayarları için Tam liste'ye bak." Style="{StaticResource Hint}" Margin="24,14,24,0"
                                       Visibility="{Binding ShowSummaryHint, Converter={StaticResource B2V}}"/>
                            <StackPanel Margin="24,12,24,0" Visibility="{Binding ShowInfo, Converter={StaticResource B2V}}">
                                <TextBlock Text="Öneriler" Style="{StaticResource GroupTitle}" Margin="0,8,0,6"/>
                                <ItemsControl ItemsSource="{Binding InfoLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Hint}" MaxWidth="400" Margin="0,0,0,8"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>

                    <!-- ölçümler: önce / sonra -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding TabMetrics, Converter={StaticResource B2V}}">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Style="{StaticResource Hint}" Text="Başlat'tan sonra önceki ve sonraki değerler burada görünür. Antilag ping'i düşürmez ve FPS'i sihirli biçimde artırmaz; arka plandaki yükü azaltır. Bilgisayar zaten temizse değerler değişmez, bu normaldir."
                                       Visibility="{Binding HasMetrics, Converter={StaticResource NotB2V}}"/>
                            <Grid Margin="0,0,0,6" Visibility="{Binding HasMetrics, Converter={StaticResource B2V}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ölçüm" Style="{StaticResource GroupTitle}"/>
                                <TextBlock Grid.Column="1" Text="Önce" Style="{StaticResource GroupTitle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Sonra" Style="{StaticResource GroupTitle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Fark" Style="{StaticResource GroupTitle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Metrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Rectangle Style="{StaticResource Hairline}"/>
                                            <Grid Margin="0,9">
                                                <Grid Visibility="{Binding IsNumbers, Converter={StaticResource B2V}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.4*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Before}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding After}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Delta}" HorizontalAlignment="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{Binding DeltaBrush}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Before}" Style="{StaticResource Hint}" Visibility="{Binding IsNote, Converter={StaticResource B2V}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Body2}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- bellek: en çok bellek kullanan 10 program -->
                    <Grid Grid.Row="3" Margin="24,16,16,16" Visibility="{Binding TabMemory, Converter={StaticResource B2V}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="En çok bellek kullanan 10 program. Kapat, programı hemen kapatır (5 saniyede kapanmazsa zorla); kaydedilmemiş iş kaybolur. Kapatılan programı ana ekrandaki geri açma düğmesi yeniden açar. Korumalı olanlar kapatılamaz." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Yenile" Padding="14,8" MinHeight="36" VerticalAlignment="Top" Command="{Binding RefreshMemoryCommand}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TopMemory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Rectangle Style="{StaticResource Hairline}"/>
                                            <Grid Margin="0,8,8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="58"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Hint}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding MbText}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="0,0,10,0"/>
                                                <Button Grid.Column="2" Content="Kapat" Padding="14,7" MinHeight="34" MinWidth="64" HorizontalAlignment="Right" FontSize="13" AutomationProperties.Name="{Binding Name, StringFormat='Kapat: {0}'}"
                                                        Command="{Binding CloseCommand}" Visibility="{Binding CanClose, Converter={StaticResource B2V}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Tag}" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
